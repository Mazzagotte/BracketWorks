{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Next.js dev)",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd", "frontend", "&&", "yarn", "dev"],
      "port": 3000
    },
    {
      "name": "Backend (FastAPI dev)",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd", "backend", "&&", "python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "All (Docker Compose)",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "docker-compose", "up", "--build"],
      "port": 3000
    }
  ]
}

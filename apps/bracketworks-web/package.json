{
  "name": "@bracketworks/bracketworks-web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000 --webpack",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --cache --cache-strategy content --cache-location .eslintcache --report-unused-disable-directives && npm run lint:ui-rules",
    "lint:ui-rules": "node ./scripts/enforce-ui-css-rules.mjs",
    "lint:ui-rules:full": "node ./scripts/enforce-ui-css-rules.mjs --full",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "browserslist:update": "npx.cmd update-browserslist-db@latest"
  },
  "dependencies": {
    "@bracketworks/ui": "workspace:*",
    "exceljs": "^3.4.0",
    "lucide-react": "^0.539.0",
    "next": "16.3.0",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-jsx": "^5.1.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "tmp": "0.2.7",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.9",
    "fast-csv": "4.3.6",
    "@eslint/config-array": {
      "minimatch": {
        "brace-expansion": "2.0.2"
      }
    },
    "@eslint/eslintrc": {
      "minimatch": {
        "brace-expansion": "2.0.2"
      }
    },
    "eslint": {
      "minimatch": {
        "brace-expansion": "2.0.2"
      }
    },
    "eslint-plugin-import": {
      "brace-expansion": "2.1.2"
    },
    "eslint-plugin-jsx-a11y": {
      "brace-expansion": "2.1.2"
    },
    "eslint-plugin-react": {
      "brace-expansion": "2.1.2"
    },
    "next": {
      "postcss": "8.5.22"
    }
  }
}

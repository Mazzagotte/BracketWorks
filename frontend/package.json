{
  "name": "bracketworks-web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint && npm.cmd run lint:ui-rules",
    "lint:ui-rules": "node ./scripts/enforce-ui-css-rules.mjs",
    "lint:ui-rules:full": "node ./scripts/enforce-ui-css-rules.mjs --full",
    "typecheck": "tsc --noEmit",
    "browserslist:update": "npx.cmd update-browserslist-db@latest"
  },
  "dependencies": {
    "next": "14.2.5",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-jsx": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "typescript": "^5.5.4"
  }
}

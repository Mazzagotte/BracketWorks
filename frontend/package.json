{
  "name": "bracketworks-web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000 --webpack",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --cache --cache-strategy content --cache-location .eslintcache --report-unused-disable-directives --ext .js,.jsx,.ts,.tsx --ignore-pattern node_modules --ignore-pattern .next --ignore-pattern node_modules_stale_* && npm run lint:ui-rules",
    "lint:ui-rules": "node ./scripts/enforce-ui-css-rules.mjs",
    "lint:ui-rules:full": "node ./scripts/enforce-ui-css-rules.mjs --full",
    "typecheck": "tsc --noEmit",
    "browserslist:update": "npx.cmd update-browserslist-db@latest"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "^16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-jsx": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
